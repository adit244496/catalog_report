# Copy this file to .env and fill in real values. Do NOT commit .env.

# Security — set a strong random value in production
SECRET_KEY=change_me_to_a_long_random_string

# Database
DATABASE_URL=postgresql+pg8000://postgres:your_password@localhost:5432/matcat

# Default seed accounts (created on first startup only).
# Leave a password blank to skip creating that account.
DEFAULT_SUPERADMIN_USERNAME=superadmin
DEFAULT_SUPERADMIN_PASSWORD=
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# AWS S3 (fill these in when deploying to AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=matcat-assets
